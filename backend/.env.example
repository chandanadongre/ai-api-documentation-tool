# Database — use db:5432 when running via Docker Compose, localhost:5432 for local dev
DATABASE_URL=postgresql://postgres:password@localhost:5432/apiforge

SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

GROQ_API_KEY=your-groq-api-key-from-groq-com
GITHUB_TOKEN=optional-github-personal-access-token

# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:4200,http://localhost:80
